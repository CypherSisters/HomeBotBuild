# Copy to ".env.local" in this directory (dashboard/.env.local).
#
# Next.js reads .env.local on the SERVER side only — nothing here is inlined
# into the browser bundle, which is why the API key may live in this file and
# must never be moved into a NEXT_PUBLIC_* variable. .env.local is git-ignored.
# `install.sh --with-dashboard` and `install.ps1 -WithDashboard` write this file
# for you, filled in from the key the installer already minted; do it by hand
# only if you are running the dashboard without the installer.
#
# Without this file the dashboard starts, renders, and then every call it makes
# into the backend comes back 401 — the pages load empty rather than failing
# loudly. That is the one symptom this file fixes.

# Where the HomeBot backend answers, as seen from the dashboard SERVER process
# (not from the browser). Both names are read; keep them the same.
PUFFPAI_API_URL=http://127.0.0.1:8000
PUFFPAI_BACKEND_URL=http://127.0.0.1:8000

# The key the backend will accept. Copy the PUFFPAI_API_KEY line from the
# per-install environment file the installer wrote into your state directory:
#   Windows:  %LOCALAPPDATA%\PuffPAI\homebot.env
#   Linux:    ~/.local/share/puffpai/homebot.env   ($PUFFPAI_DATA_DIR if set)
# It is the same secret on both sides: the backend authorises every request with
# it, so treat this file the way you treat that one.
PUFFPAI_API_KEY=

# How hard the pairing gate bites. "knowledge" gates the document and knowledge
# routes and leaves the rest of the dashboard open, which is the right setting
# for a machine you are still setting up. "all" gates every route and is what a
# box on a household LAN should end up on. Unset behaves as "knowledge".
PUFF_PAIRING_ENFORCE=knowledge

# Browser-side base path for API calls. The dashboard proxies them through its
# own server, which is what keeps the key above out of the browser. Leave as is
# unless you are serving the dashboard under a path prefix.
NEXT_PUBLIC_API_URL=/api/pai
