# Copy to .env.production before `npm run build`.
# Next.js inlines NEXT_PUBLIC_* into the client bundle at BUILD time, so
# everything in this file is public by construction. Never put a secret
# here - a secret in a NEXT_PUBLIC_ variable is a published secret.
NEXT_PUBLIC_API_URL=/api/pai
NEXT_PUBLIC_APP_NAME=PuffPAI
NEXT_PUBLIC_VERSION=1.0.0
