# PuffPAI kiosk configuration — installed to /etc/puffpai/kiosk.env by
# scripts/provision_kiosk.sh (only if absent; edits here are never clobbered).
# Read by /opt/puffpai-kiosk/kiosk-session.sh at session start; to apply
# changes, restart the session (sudo systemctl restart gdm3).

# Page shown on the wall display.
KIOSK_URL=http://127.0.0.1:3003/dashboard

# Night window during which the display is blanked (24h HH:MM, box-local
# time). Set either to empty to keep the screen on around the clock.
DISPLAY_OFF=23:00
DISPLAY_ON=06:30
