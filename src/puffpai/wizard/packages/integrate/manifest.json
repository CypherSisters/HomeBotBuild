      "docs.astropy.org",
      "download.kiwix.org",
      "medlineplus.gov"
    ],
    "files": [
      "data"
    ],
    "ha_domains": [],
    "secrets": []
  },
  "doors": [],
  "secrets": [],
  "egress": "build_only",
