# HomeBotBuild — Docker Compose environment (example)
#
# Copy to ".env" beside the docker-compose*.yml files and edit. Docker Compose
# reads ".env" automatically; nothing else does. The HomeBot backend itself is
# configured from config/puffpai_config.json and the per-install environment
# file the installer writes into your state directory
# (%LOCALAPPDATA%\PuffPAI\homebot.env / ~/.local/share/puffpai/homebot.env) --
# NOT from this file.
#
# Every compose service here is INDEPENDENTLY OPTIONAL. Bring your own media,
# storage, vaults and edge security, or bring none of them: each absence greys
# out one surface and changes nothing else. See README.md for the table of what
# degrades.
#
# DO NOT COMMIT your filled-in .env. It carries tokens.

# ── Everything (all compose files) ────────────────────────────────────────────

# The LAN IPv4 address of THIS machine. Every published port binds to it
# explicitly rather than to 0.0.0.0, so a service is reachable on your network
# and on nothing else. There is no default: guessing which interface a
# household's DNS resolver should answer on is not a thing software should do.
#   Linux:   ip -4 route get 1.1.1.1
#   Windows: (Get-NetIPAddress -AddressFamily IPv4).IPAddress
PUFFPAI_BIND_IP=192.168.1.50

# Container timezone, IANA form. Affects log stamps and schedules.
TZ=Etc/UTC

# ── docker-compose.media.yml — Jellyfin + Calibre-Web (OPTIONAL) ──────────────
# Bring your own media. This directory is mounted READ-ONLY into both
# containers; HomeBot never writes to your library.
#   Expected layout:  <dir>/movies  <dir>/music  <dir>/books  <dir>/tv
# Without media containers: the Media page lists nothing and "play <title>"
# answers that no media server is configured. Chat, apps and the dashboard are
# unaffected.
#
# NOTE — two names for one directory. The setup wizard stores your library path
# in config/puffpai_config.json as "media_server.media_mount"; these containers
# read PUFFPAI_MEDIA_DIR. Nothing syncs them, so set both to the SAME path or
# the Media page will list a library the containers are not serving. See
# docs/CONFIG.md, "Media directory: two names for one path".
PUFFPAI_MEDIA_DIR=/srv/media

# ── docker-compose.zone3.yml — AdGuard Home (OPTIONAL, LINUX ONLY) ────────────
# Overrides PUFFPAI_BIND_IP for the DNS ports only, when the sinkhole should
# answer on a different interface from the rest of HomeBot. Leave unset to use
# PUFFPAI_BIND_IP. Port 53 must be free (on Ubuntu, systemd-resolved holds it).
# Without Zone 3: the Bridge page shows the network edge as not installed.
#ZONE3_BIND_IP=192.168.1.50

# ── docker-compose.nodered.yml — automations (OPTIONAL) ───────────────────────
# Node-RED runs the scheduled flows (briefings, weather, grocery, media
# now-playing). Without it: those flows never fire; everything you trigger by
# hand or by voice still works.
#
# How the flows reach HomeBot. host.docker.internal resolves to the host on
# Docker Desktop and on Linux with the extra_hosts entry the compose file sets.
PUFFPAI_API_URL=http://host.docker.internal:8000
# Must equal the PUFFPAI_API_KEY in your state directory's homebot.env.
PUFFPAI_API_KEY=
# Where Ollama listens, as seen FROM the container.
OLLAMA_URL=http://host.docker.internal:11434
# Home Assistant (OPTIONAL). Without it: house control is unavailable and the
# HA cards report "not connected"; nothing else changes.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Jellyfin, as seen from the automation container (OPTIONAL).
# (Whatever address Jellyfin answers on AS SEEN FROM the container: with
# network_mode: bridge that is usually http://host.docker.internal:8096.)
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
# Daily-news flow: an RSS feed YOU choose. No feed ships enabled and there is
# no default. While this is empty both news flows stop at their first node and
# make no outbound request at all. Node-RED runs in its own container and does
# not consult HomeBot's egress doors, so a feed shipped enabled would be a
# connection nobody in the house agreed to and nobody could switch off from
# Settings > Egress. Every host these flows reach is one you named in this file.
NEWS_RSS_URL=
# Fallback coordinates for weather when no household location is set.
WEATHER_DEFAULT_LAT=39.7392
WEATHER_DEFAULT_LON=-104.9903
# Sent as User-Agent on outbound requests the automations make. api.weather.gov
# requires one. Keep it generic: it is the one string a remote host always sees.
PUFFPAI_USER_AGENT=PuffPAI/1.0 (node-red)

# ── docker-compose.spotify.yml / spotify-voice.yml (OPTIONAL) ─────────────────
# librespot advertises itself on the LAN using PUFFPAI_BIND_IP (above) as the
# zeroconf interface; it needs no variables of its own. Without it: Spotify
# Connect does not appear as a target and the music surface falls back to your
# local library and the radio sources.
